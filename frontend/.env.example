# Base URL for the Spring Boot backend API.
#
# Development (Vite dev proxy via server.proxy):
# Leave empty or unset so requests resolve relative to the local dev server (e.g. /accounts).
# VITE_API_BASE_URL=
#
# Production (Render Deployment):
# Set to the canonical Render backend origin:
VITE_API_BASE_URL=https://event-sourced-ledger-backend.onrender.com
